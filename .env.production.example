# ====================================
# Candway Intelligence Platform
# Production Environment Configuration
# ====================================
# CRITICAL: Generate UNIQUE values for every secret below.
# NEVER reuse secrets from dev, staging, or other environments.
#
# Required secrets checklist:
#   [ ] SECRET_KEY
#   [ ] CANDWAY_FIELD_ENCRYPTION_KEY
#   [ ] DATABASE_URL (with dedicated user, NOT root)
#   [ ] REDIS_PASSWORD + REDIS_URL
#   [ ] GROQ_API_KEY (or DEEPSEEK/GEMINI)
#   [ ] SMTP_PASSWORD
#   [ ] ALLOWED_ORIGINS (your actual domain)

# ====================================
# Application
# ====================================
APP_NAME=Candway Intelligence
DEBUG=false
ENVIRONMENT=production
SETUP_COMPLETE=true
ENFORCE_EMAIL_VERIFICATION=true

# ====================================
# Security — ROTATE THESE BEFORE DEPLOYING
# ====================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_SECRET_KEY

# Field-level PII encryption key (REQUIRED for GDPR compliance)
# Encrypts cv_text, analysis_json, interview_log, calibration_json at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Losing this key makes all encrypted PII columns unreadable.
# The app REFUSES TO START without this key in production.
# CANDWAY_FIELD_ENCRYPTION_KEY=

# ====================================
# Database — USE A STRONG PASSWORD
# ====================================
# Create a dedicated MySQL user (NOT root):
#   CREATE USER 'candway_app'@'%' IDENTIFIED BY 'your_generated_password';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON candway_db.* TO 'candway_app'@'%';
DATABASE_URL=mysql+pymysql://candway_user:STRONG_PASSWORD_HERE@localhost:3306/candway_db

# Docker MySQL credentials (only used by docker-compose.yml)
# MYSQL_ROOT_PASSWORD=replace_with_root_password
# MYSQL_PASSWORD=replace_with_app_password

# ====================================
# Redis (REQUIRED for rate limiting / token blacklist)
# ====================================
# Generate a strong password: openssl rand -base64 32
# REDIS_PASSWORD=replace_with_redis_password
# REDIS_URL=redis://:replace_with_redis_password@redis:6379/0

# ====================================
# Admin User
# ====================================
ADMIN_EMAIL=admin@candway.io
ADMIN_NAME=Admin

# ====================================
# AI Provider Keys (at least one required for AI features)
# ====================================
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ====================================
# CORS & Trusted Hosts (comma-separated)
# ====================================
ALLOWED_ORIGINS=https://candway.io,https://www.candway.io
ALLOWED_HOSTS=candway.io,www.candway.io

# ====================================
# Sentry Error Tracking (optional but recommended)
# ====================================
SENTRY_DSN=

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================================
# Email (SMTP)
# ====================================
# Gmail: use App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ====================================
# Konnect Payment Gateway (optional)
# ====================================
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=

# ====================================
# Database performance
# ====================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ====================================
# File upload security
# ====================================
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.doc,.docx

# ====================================
# Grafana monitoring
# ====================================
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ====================================
# Redis rate limiting
# ====================================
REDIS_MAX_CONNECTIONS=50
