class Application(Base, TenantMixin):
    __tablename__ = "applications"
    __table_args__ = (
        Index("idx_applications_status_created", "status", "created_at"),
        Index("idx_applications_email", "email"),
        Index("idx_applications_user_status", "user_id", "status"),
        Index("idx_applications_assigned_status", "assigned_to", "status"),
        Index("idx_applications_batch_status", "batch_id", "status"),
        Index("idx_applications_user_job", "user_id", "job_id"),
        Index("idx_applications_company", "company_id"),
        Index("idx_applications_rubric", "rubric_id"),
        CheckConstraint(
            "analysis_score IS NULL OR (analysis_score >= 0 AND analysis_score <= 100)",
            name="ck_application_analysis_score_range",
        ),
        CheckConstraint(
            "evaluation_state IS NULL OR evaluation_state IN ('pending', 'running', 'completed', 'failed', 'flagged', 'expired', 'override')",
            name="ck_application_evaluation_state",
        ),
        CheckConstraint(
            "status IS NULL OR status IN ('pending', 'screening', 'interviewing', 'offer', 'rejected', 'analyzed', 'failed', 'applied', 'invited', 'active', 'analyzing', 'analysis_failed', 'hired', 'offer_declined', 'withdrawn', 'imported', 'reviewed', 'shortlisted')",
            name="ck_application_status",
        ),
        UniqueConstraint("user_id", "job_id", name="uq_applications_user_job"),
        {"extend_existing": True},
    )

    # company_id is user-scoped for standalone job seekers: an individual
    # candidate belongs to no company until they apply to a company's job
    # or are invited by a recruiter/campaign, but must still be able to
    # upload and analyze their CV. NULL until they acquire a company context.
    company_id = Column(
        Integer,
        ForeignKey("companies.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )

    id = Column(Integer, primary_key=True, index=True)
    version_id = Column(Integer, nullable=False, default=1)
    __mapper_args__ = {"version_id_col": version_id}
    user_id = Column(Integer, ForeignKey("users.id", ondelete="SET NULL"), index=True)
    candidate_id = Column(
        Integer,
        ForeignKey("candidates.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )
    job_id = Column(
        Integer, ForeignKey("jobs.id", ondelete="SET NULL"), nullable=True, index=True
    )
    batch_id = Column(
        Integer,
        ForeignKey("batch_jobs.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )
    application_type = Column(
        Enum(
            ApplicationType,
            values_callable=lambda enum_cls: [member.value for member in enum_cls],
        ),
        nullable=False,
        default=ApplicationType.MANUAL,
        server_default="manual",
        index=True,
    )

    full_name = Column(String(255))
    email = Column(String(255))
    phone = Column(String(255))

    # --- DEPRECATED: use CvDocument below ---
    declared_role = Column(String(255))  # deprecated: use CvDocument.declared_role
    detected_role = Column(
        String(255), nullable=True
    )  # deprecated: use CvDocument.detected_role
    cv_text_anonymized = deferred(
        Column(EncryptedText(8192))
    )  # deprecated: use CvDocument.cv_text_anonymized
    cv_file_path = Column(
        String(255), nullable=True
    )  # deprecated: use CvDocument.cv_file_path

    analysis_json = deferred(
        Column(EncryptedText(16384))
    )  # deprecated: use CvDocument.analysis_json
    cv_embedding = deferred(Column(Text))  # deprecated: use CvDocument.cv_embedding
    # Phase 2: these columns are deprecated — EvaluationSession is source of truth.
    # Python access goes through @property accessors that delegate to EvaluationSession.
    # DB column names remain unchanged for backward compat until a future drop migration.
    _deprecated_interview_log = deferred(
        Column("interview_log", EncryptedText(65536), default="[]")
    )
    _deprecated_interview_questions = deferred(
        Column("interview_questions", Text, default="[]")
    )
    # Phase 3B (June 2026): interview_qa_structured removed — use InterviewTurn table.

    # Candway 3.0 - Video Interview Support
    _deprecated_video_file_path = Column("video_file_path", String(512), nullable=True)
    roadmap_json = deferred(
        Column(Text, nullable=True)
    )  # deprecated: use CvDocument.roadmap_json
    cv_review_json = deferred(
        Column(Text, nullable=True)
    )  # deprecated: use CvDocument.cv_review_json

    # (interview_state, interview_progress, interview_time_left,
    #  interview_last_saved, interview_turn_seq, interview_reset_count,
    #  interview_last_reset_at, calibration_json — dropped in m16)

    final_eval_timestamp = Column(DateTime, nullable=True)

    evaluation_state = Column(String(20), default="pending", index=True)
    evaluation_completed_at = Column(DateTime, nullable=True)
    evaluation_source = Column(String(20), nullable=True)

    # Tracking
    language = Column(
        String(255), default="English"
    )  # Override or default from campaign/interview setting
    invited_at = Column(DateTime, nullable=True)  # REC #4: Timestamp of last invitation
    opened_at = Column(DateTime, nullable=True)
    clicked_at = Column(DateTime, nullable=True)

    created_at = Column(DateTime, default=utcnow, index=True)
    updated_at = Column(DateTime, default=utcnow, onupdate=utcnow)
    deleted_at = Column(DateTime, nullable=True, index=True)
    status = Column(
        String(255), default="pending", index=True
    )  # pending, screening, interviewing, offer, rejected
    source = Column(
        String(255), default="Direct", index=True
    )  # LinkedIn, Referral, Website, etc.
    recruiter_notes = deferred(
        Column(Text, nullable=True)
    )  # Recruiter feedback and notes

    # Consent Tracking (GDPR)
    consent_accepted = Column(Boolean, default=False, nullable=False)
    consent_at = Column(DateTime, nullable=True)
    consent_source = Column(String(100), nullable=True)

    # Rubric Engine integration
    rubric_id = Column(Integer, ForeignKey("rubrics.id"), nullable=True)
    # (rubric_legacy_score dropped in fe66b0844afb)
    # (rubric_version, scoring_model, rubric_seniority dropped in a2b3c4d5e6f7)

    # Bug U-07: structured decline fields. Previously the
    # candidate's decline reason was jammed into ``recruiter_notes``
    # with the prefix "Candidate declined invitation. Reason: ..."
    # which made it impossible to query, filter, or surface in the
    # recruiter UI without string parsing. These dedicated columns
    # let the recruiter list query ``status='rejected'`` and
    # render the reason as a structured badge.
    declined_at = Column(DateTime, nullable=True, index=True)
    decline_reason = deferred(Column(Text, nullable=True))
    decline_initiated_by = Column(
        String(32), nullable=True
    )  # 'candidate' or 'recruiter'

    # Bug B-31: lifting top-level analysis keys out of the JSON
    # bag. These four columns are read on every recruiter
    # candidate-list render — keeping them in a TEXT column means
    # every list query had to ``json.loads`` a 5-30 KB blob and
    # walk a dict. The new dedicated JSON columns let the SQL
    # engine prune the payload and let us index score_breakdown
    # numerically in the future.
    #
    # The bag continues to exist (we don't drop it) for the
    # remaining 14 keys (skills, summary, video_analysis_json,
    # etc.) and as a write-through fallback for legacy readers.
    analysis_strengths = deferred(Column(JSON, nullable=True))  # list[str]
    analysis_weaknesses = deferred(Column(JSON, nullable=True))  # list[str]
    analysis_score_breakdown = deferred(
        Column(JSON, nullable=True)
    )  # {cv: int, interview: int, ...}
    analysis_score = Column(Float, nullable=True, index=True)

    # Candidate Assignment (ATS Enhancement)
    assigned_to = Column(
        Integer, ForeignKey("users.id"), nullable=True, index=True
    )  # Assigned recruiter
    assigned_at = Column(DateTime, nullable=True)  # When assignment was made

    candidate = relationship(
        "Candidate", back_populates="applications", foreign_keys=[candidate_id]
    )
    owner = relationship("User", back_populates="applications", foreign_keys=[user_id])
    assignee = relationship("User", foreign_keys=[assigned_to])

    job = relationship("Job")
    batch_job = relationship(
        "BatchJob", back_populates="applications", foreign_keys=[batch_id]
    )

    # SECURE: Explicit cascade delete for linked records
    interviews_list = relationship(
        "Interview", back_populates="application", cascade="all, delete-orphan"
    )
    comments_list = relationship(
        "Comment", back_populates="application", cascade="all, delete-orphan"
    )
    ratings_list = relationship(
        "CandidateRating", back_populates="application", cascade="all, delete-orphan"
    )
    activity_logs_list = relationship(
        "ActivityLog", back_populates="application", cascade="all, delete-orphan"
    )

    # Extracted domain entities (one-to-one, populated lazily)
    cv_document = relationship(
        "CvDocument",
        back_populates="application",
        uselist=False,
        cascade="all, delete-orphan",
    )

    # North Star relationships (added in architecture migration)
    # order_by=id.desc() ensures [0] returns the latest session (fixes Bug 2)
    evaluation_sessions = relationship(
        "EvaluationSession",
        back_populates="application",
        cascade="all, delete-orphan",
        order_by="EvaluationSession.id.desc()",
    )
    verdicts = relationship(
        "Verdict",
        back_populates="application",
        foreign_keys="Verdict.application_id",
        cascade="all, delete-orphan",
    )

    # back_populates counterparts (migrated from backref)
    eeo_consent = relationship(
        "EEOConsent",
        back_populates="application",
        uselist=False,
        cascade="all, delete-orphan",
    )
    offers = relationship(
        "Offer", back_populates="application", cascade="all, delete-orphan"
    )
    background_checks = relationship(
        "BackgroundCheck", back_populates="application", cascade="all, delete-orphan"
    )
    application_stage_history = relationship(
        "ApplicationStageHistory",
        back_populates="application",
        cascade="all, delete-orphan",
    )
    tagged_notes = relationship(
        "TaggedNote", back_populates="application", cascade="all, delete-orphan"
    )
    interactions = relationship(
        "CandidateInteraction",
        back_populates="application",
        cascade="all, delete-orphan",
    )
    scorecard_submissions = relationship(
        "ScorecardSubmission",
        back_populates="application",
        cascade="all, delete-orphan",
    )

    # Cascade for child tables with application_id FK (deletion safety)
    extracted_skills = relationship(
        "ExtractedSkill", back_populates="application", cascade="all, delete-orphan"
    )
    qualifications = relationship(
        "Qualification", back_populates="application", cascade="all, delete-orphan"
    )
    email_sequence_logs = relationship(
        "EmailSequenceLog", back_populates="application", cascade="all, delete-orphan"
    )
    reengagement_candidates = relationship(
        "ReEngagementCandidate",
        back_populates="application",
        cascade="all, delete-orphan",
    )
    calibration_samples = relationship(
        "CalibrationSample", back_populates="application", cascade="all, delete-orphan"
    )
    ai_audit_logs = relationship(
        "AIAuditLog", back_populates="application", cascade="all, delete-orphan"
    )
    interview_turns = relationship(
        "InterviewTurn", back_populates="application", cascade="all, delete-orphan"
    )

    # ── Phase 3: READ-ONLY delegation to EvaluationSession ───────────
    # These read from EvaluationSession (single source of truth).
    # Use sync_ai_interview_session() to write; direct instance writes
    # via setter are silently discarded (no-op setter prevents
    # SQLAlchemy constructor from raising on kwarg like interview_state).

    def _latest_eval_session(self):
        if not self.evaluation_sessions:
            return None
        return sorted(self.evaluation_sessions, key=lambda s: s.id or 0, reverse=True)[
            0
        ]

    @property
    def interview_state(self):
        es = self._latest_eval_session()
        return es.interview_state if es is not None else None

    @interview_state.setter
    def interview_state(self, value):
        pass

    @property
    def interview_progress(self):
        es = self._latest_eval_session()
        return es.interview_progress if es is not None else None

    @interview_progress.setter
    def interview_progress(self, value):
        pass

    @property
    def interview_time_left(self):
        es = self._latest_eval_session()
        return es.interview_time_left if es is not None else None

    @interview_time_left.setter
    def interview_time_left(self, value):
        pass

    @property
    def interview_last_saved(self):
        es = self._latest_eval_session()
        return es.interview_last_saved if es is not None else None

    @interview_last_saved.setter
    def interview_last_saved(self, value):
        pass

    @property
    def interview_log(self):
        es = self._latest_eval_session()
        return es.interview_log if es is not None else None

    @interview_log.setter
    def interview_log(self, value):
        # Compatibility setter: EvaluationSession is the source of truth.
        # Keep writes through the legacy Application property working by
        # forwarding them to the latest EvaluationSession.
        es = self._latest_eval_session()
        if es is not None:
            es.interview_log = value

    @property
    def interview_questions(self):
        es = self._latest_eval_session()
        return es.interview_questions if es is not None else None

    @interview_questions.setter
    def interview_questions(self, value):
        pass

    @property
    def interview_turn_seq(self):
        es = self._latest_eval_session()
        return es.interview_turn_seq if es is not None else None

    @interview_turn_seq.setter
    def interview_turn_seq(self, value):
        pass

    @property
    def interview_reset_count(self):
        es = self._latest_eval_session()
        return es.interview_reset_count if es is not None else None

    @interview_reset_count.setter
    def interview_reset_count(self, value):
        pass

    @property
    def interview_last_reset_at(self):
        es = self._latest_eval_session()
        return es.interview_last_reset_at if es is not None else None

    @interview_last_reset_at.setter
    def interview_last_reset_at(self, value):
        pass

    @property
    def calibration_json(self):
        es = self._latest_eval_session()
        return es.calibration_json if es is not None else None

    @calibration_json.setter
    def calibration_json(self, value):
        pass

    @property
    def video_file_path(self):
        es = self._latest_eval_session()
        return es.video_file_path if es is not None else None

    @video_file_path.setter
    def video_file_path(self, value):
        pass


