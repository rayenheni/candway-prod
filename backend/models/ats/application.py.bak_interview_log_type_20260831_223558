class CvDocument(Base, TenantMixin):
    """Extracted CV data — lifted from Application JSON bag and columns.

    One row per application. Stores the raw CV text, extracted skills,
    AI analysis, and embedding vector.
    """

    __tablename__ = "cv_documents"
    __table_args__ = (
        Index("idx_cv_doc_app", "application_id", unique=True),
        Index("idx_cv_doc_eval_session", "evaluation_session_id"),
        {"extend_existing": True},
    )

    version_id = Column(Integer, nullable=False, default=1)
    __mapper_args__ = {"version_id_col": version_id}

    # company_id is user-scoped for standalone job seekers (see Application).
    # A CV can be uploaded before any company context exists; NULL until the
    # candidate applies to a company's job or is invited by a recruiter.
    company_id = Column(
        Integer,
        ForeignKey("companies.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )

    id = Column(Integer, primary_key=True, index=True)
    application_id = Column(
        Integer,
        ForeignKey("applications.id", ondelete="CASCADE"),
        nullable=False,
        unique=True,
    )
    evaluation_session_id = Column(
        Integer,
        ForeignKey("evaluation_sessions.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )

    cv_text = deferred(Column(Text, nullable=True))
    cv_file_path = Column(String(255), nullable=True)
    cv_text_anonymized = deferred(Column(Text, nullable=True))

    extracted_skills = deferred(Column(JSON, default=list))
    cv_embedding = deferred(Column(Text, nullable=True))  # JSON-serialized vector

    analysis_json = deferred(Column(JSON, nullable=True))
    cv_review_json = deferred(Column(JSON, nullable=True))
    roadmap_json = deferred(Column(JSON, nullable=True))

    detected_role = Column(String(255), nullable=True)
    declared_role = Column(String(255), nullable=True)

    created_at = Column(DateTime, default=utcnow)
    updated_at = Column(DateTime, default=utcnow, onupdate=utcnow)

    application = relationship(
        "Application", back_populates="cv_document", foreign_keys=[application_id]
    )
    evaluation_session = relationship(
        "EvaluationSession",
        back_populates="cv_document",
        foreign_keys=[evaluation_session_id],
    )


