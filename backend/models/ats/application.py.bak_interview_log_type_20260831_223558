class Qualification(Base, TenantMixin):
    """Documents a candidate uploads as supporting evidence for
    a job application: degrees, certificates, transcripts, licences.

    Replaces the previous ``analysis_json["qualifications"]`` JSON
    bag on ``Application``. The bag was a 20-purpose dictionary that
    made the rows balloon to > 100 KB after a dozen uploads, slowed
    every ``Application`` read, and offered no way to query, index,
    or cascade-delete.

    Schema choices:
      * ``id`` is a short, human-friendly hex (mirrors the old
        ``uuid.uuid4().hex[:8]`` shape so existing bookmarks don't
        break).
      * ``user_id`` and ``application_id`` are nullable so a
        candidate can upload before they have an Application row
        (a quirk of the existing flow).
      * ``verified`` defaults to False; admin tools can flip it.
    """

    __tablename__ = "qualifications"
    __table_args__ = (
        Index("idx_qualifications_user", "user_id"),
        Index("idx_qualifications_app", "application_id"),
        UniqueConstraint("user_id", "title", "category", name="uq_qual_user_title_cat"),
        {"extend_existing": True},
    )

    # company_id is user-scoped, mirroring candidate_profiles: candidates
    # belong to no company until they apply to a company's job, so they
    # must be able to upload supporting documents before any Application
    # row exists. NULL until they acquire a company context.
    company_id = Column(
        Integer,
        ForeignKey("companies.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )

    id = Column(String(16), primary_key=True, index=True)
    user_id = Column(Integer, ForeignKey("users.id"), nullable=True, index=True)
    application_id = Column(
        Integer, ForeignKey("applications.id"), nullable=True, index=True
    )
    title = Column(String(200), nullable=False)
    category = Column(String(32), nullable=False)
    filename = Column(String(255), nullable=False)
    file_url = Column(String(500), nullable=False)
    file_size = Column(Integer, nullable=False, default=0)
    mime_type = Column(String(64), nullable=False, default="application/octet-stream")
    verified = Column(Boolean, default=False, nullable=False)
    uploaded_at = Column(DateTime, default=utcnow, nullable=False)
    deleted_at = Column(
        DateTime, nullable=True
    )  # soft-delete; file on disk still removed

    # Relationships
    user = relationship("User", foreign_keys=[user_id])
    application = relationship(
        "Application", back_populates="qualifications", foreign_keys=[application_id]
    )


