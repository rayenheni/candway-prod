def _compute_candidate_rank(
    db: Session, app: Application
) -> Optional[dict]:
    """Compute the candidate's rank among all scored applicants for the same
    job (or campaign batch). Only applicants with a final EvaluationResult
    score are ranked. Returns None when there is nothing to rank against
    (no job/batch, no score, or no scored peers).
    """
    if not app.job_id and not app.batch_id:
        return None
    target_col = Application.job_id if app.job_id else Application.batch_id
    target_val = app.job_id or app.batch_id

    rows = (
        db.query(Application.id, EvaluationResult.final_score)
        .join(
            EvaluationSession,
            EvaluationSession.application_id == Application.id,
        )
        .join(
            EvaluationResult,
            EvaluationResult.evaluation_session_id == EvaluationSession.id,
        )
        .filter(
            target_col == target_val,
            EvaluationResult.final_score.isnot(None),
        )
        .all()
    )
    scored = [r for r in rows if r.final_score is not None]
    if len(scored) < 2:
        return None

    my_score = None
    for r in rows:
        if r.id == app.id:
            my_score = r.final_score
            break
    if my_score is None:
        return None

    # Rank is 1-based with ties sharing the best position (competition rank).
    rank = 1 + sum(1 for r in scored if (r.final_score or 0) > (my_score or 0))
    total = len(scored)
    percentile = round((1 - (rank - 1) / total) * 100)
    return {
        "rank": rank,
        "total": total,
        "percentile": percentile,
        "score": my_score,
    }


