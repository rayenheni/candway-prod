# ===================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================
# CRITICAL: Generate new values for all secrets before deploying!
# NEVER reuse secrets from dev, staging, or other environments.
#
# Service                    | Required | How to generate
# ---------------------------|----------|-------------------------------------------
# SECRET_KEY                 | YES      | openssl rand -hex 32
# CANDWAY_FIELD_ENCRYPTION_KEY | YES    | python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATABASE_URL               | YES      | Create dedicated DB user, set strong password
# REDIS_PASSWORD + REDIS_URL | YES      | openssl rand -base64 32
# GROQ_API_KEY               | YES      | https://console.groq.com
# SMTP_PASSWORD              | YES      | Gmail App Password
# ALLOWED_ORIGINS            | YES      | Your production domain

# ===================================
# 1. APPLICATION SECRETS
# ===================================
# SECURITY: Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING_FROM_OPENSSL

# Field-level PII encryption key (REQUIRED)
# Encrypts cv_text, analysis_json, interview_log, calibration_json at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Losing this key makes all encrypted PII columns unreadable.
# The app REFUSES TO START without this key in production.
# CANDWAY_FIELD_ENCRYPTION_KEY=

# Previous encryption key (OPTIONAL, for key rotation only)
# CANDWAY_FIELD_ENCRYPTION_KEY_PREVIOUS=

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================================
# 2. DATABASE CONFIGURATION
# ===================================
# SECURITY: Create dedicated user with strong password
# Example:
#   CREATE USER 'candway_app'@'localhost' IDENTIFIED BY 'strong_password_here';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON candway_db.* TO 'candway_app'@'localhost';
DATABASE_URL=mysql+pymysql://candway_app:REPLACE_WITH_DB_PASSWORD@localhost/candway_db

# Docker MySQL credentials (only used by docker-compose.yml)
# MYSQL_ROOT_PASSWORD=replace_with_root_password
# MYSQL_PASSWORD=replace_with_app_password

# Connection Pool Settings (Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ===================================
# 3. REDIS (REQUIRED for rate limiting)
# ===================================
# Generate a strong password: openssl rand -base64 32
# REDIS_PASSWORD=replace_with_redis_password
# REDIS_URL=redis://:replace_with_redis_password@localhost:6379/0

# ===================================
# 4. PAYMENT GATEWAY (Konnect)
# ===================================
# Obtain from Konnect dashboard
KONNECT_WALLET_ID=REPLACE_WITH_KONNECT_WALLET_ID
KONNECT_API_KEY=REPLACE_WITH_KONNECT_API_KEY
KONNECT_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ===================================
# 5. EMAIL SERVICE (SMTP)
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
SMTP_FROM=noreply@yourdomain.com

# ===================================
# 6. AI SERVICES
# ===================================
# DeepSeek (Local/Primary)
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (Fallback)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY

# ===================================
# 7. CORS & SECURITY
# ===================================
# Production domain only (no wildcards!)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Headers
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ===================================
# 8. MONITORING & LOGGING
# ===================================
# Sentry (Error Tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log Level (production should be INFO or WARNING)
LOG_LEVEL=INFO

# ===================================
# 9. APPLICATION SETTINGS
# ===================================
# CRITICAL: Set to False in production!
DEBUG=False

# Environment
ENVIRONMENT=prod
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# File Upload Limits (bytes)
MAX_UPLOAD_SIZE=5242880

# ===================================
# 10. FEATURE FLAGS
# ===================================
ENABLE_REGISTRATION=True
ENFORCE_EMAIL_VERIFICATION=true

# ===================================
# GENERATION INSTRUCTIONS
# ===================================
# 1. Generate SECRET_KEY:
#    openssl rand -hex 32
#
# 2. Generate CANDWAY_FIELD_ENCRYPTION_KEY:
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 3. Generate strong DB password:
#    openssl rand -base64 32
#
# 4. Generate strong Redis password:
#    openssl rand -base64 32
#
# 5. Create database user:
#    mysql -u root -p
#    CREATE USER 'candway_app'@'localhost' IDENTIFIED BY 'your_generated_password';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON candway_db.* TO 'candway_app'@'localhost';
#    FLUSH PRIVILEGES;
#
# 6. Update Konnect credentials from dashboard
#
# 7. Configure SMTP (Gmail: use App Password, not regular password)
#
# 8. Update ALLOWED_ORIGINS to your actual domain
#
# 9. Set CANDWAY_FIELD_ENCRYPTION_KEY — app refuses to start without it
#
# 10. Test in staging before production!
