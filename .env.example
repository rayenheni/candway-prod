# ====================================
# Candway Intelligence Platform
# Environment Configuration Template
# ====================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# Required secrets checklist:
#   [ ] SECRET_KEY
#   [ ] CANDWAY_FIELD_ENCRYPTION_KEY
#   [ ] DATABASE_URL (with dedicated user, NOT root)
#   [ ] REDIS_PASSWORD + REDIS_URL
#   [ ] GROQ_API_KEY (at least one AI provider key)
#
# ====================================
# Application
# ====================================
APP_NAME=Candway Intelligence
DEBUG=false
ENVIRONMENT=dev
SETUP_COMPLETE=true
ENFORCE_EMAIL_VERIFICATION=false

# ====================================
# Security
# ====================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_generate_a_unique_key

# Field-level PII encryption key (REQUIRED for GDPR compliance)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CANDWAY_FIELD_ENCRYPTION_KEY=

# ====================================
# Database — USE A DEDICATED USER (NOT root)
# ====================================
# Create a dedicated MySQL user:
#   CREATE USER 'candway_app'@'%' IDENTIFIED BY 'your_generated_password';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON candway_db.* TO 'candway_app'@'%';
DATABASE_URL=mysql+pymysql://candway_app:your_password@127.0.0.1:3306/candway_db

# Docker MySQL credentials (only used by docker-compose.yml)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ====================================
# Redis
# ====================================
REDIS_PASSWORD=
REDIS_URL=redis://:your_password@localhost:6379/0

# ====================================
# AI Provider Keys (at least one required for AI features)
# ====================================
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ====================================
# CORS & Trusted Hosts (comma-separated)
# ====================================
ALLOWED_ORIGINS=http://localhost:8002
ALLOWED_HOSTS=localhost

# ====================================
# Sentry Error Tracking (optional)
# ====================================
SENTRY_DSN=

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================================
# Email (SMTP)
# ====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ====================================
# Database performance
# ====================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ====================================
# Checkr Background Check Integration
# ====================================
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
